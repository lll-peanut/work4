<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        配置集中管理属性
        我们可以直接改属性的 value 值
        格式: ${name}
    -->
    <!--控制台日志输出格式-->
    <property name="pattern" value="%highlight(%-5level) %d{yyyy-MM-dd HH:mm:ss.SSS} %c %M %L [%thread] %m%n"></property>
    <!--
    日志输出格式:
        %-5level
        %d{yyyy-MM-dd HH:mm:ss.SSS}日期
        %c类的完整名称
        %M为method
        %L为行号
        %thread线程名称
        %m或者%msg为信息
        %n换行
    -->
    <property name="file_pattern" value="%-5level %d{yyyy-MM-dd HH:mm:ss.SSS} %c %M %L [%thread] %m%n"></property>

    <!-- 日志输出地址  -->
    <property name="LOG_DIR" value="${base.path}/log"></property>

    <!-- 日志保留30天 -->
    <property name="MAX_HISTORY" value="30" />
    <!-- 单个日志文件最大10MB -->
    <property name="MAX_FILE_SIZE" value="10MB" />

    <!-- 异步队列容量（高并发场景建议4096-16384） -->
    <property name="QUEUE_SIZE" value="8192" />

    <!--控制台日志输出的 appender-->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <!--日志消息格式配置-->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${pattern}</pattern>
        </encoder>
        <!-- 过滤：仅保留WARN、ERROR级别，拒绝INFO/DEBUG/TRACE -->
<!--        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">-->
<!--            <level>WARN</level> &lt;!&ndash; 阈值设为WARN，仅输出WARN及以上级别 &ndash;&gt;-->
<!--        </filter>-->
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 指向同步文件Appender -->
        <appender-ref ref="FILE"/>
        <!-- 异步队列容量（根据QPS调整，8192适配大部分高并发场景） -->
        <queueSize>${QUEUE_SIZE}</queueSize>
        <!-- 丢弃阈值：0表示队列满时不丢弃任何日志（除了DEBUG/TRACE），优先阻塞 -->
        <discardingThreshold>0</discardingThreshold>
        <!-- 核心：ERROR级别日志不丢弃，即使队列满也强制写入 -->
        <includeCallerData>false</includeCallerData>
        <neverBlock>false</neverBlock> <!-- 队列满时阻塞生产线程（避免丢失核心日志） -->
    </appender>

    <!-- 5. ERROR日志异步兜底 -->
    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ERROR_FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock> <!-- ERROR日志队列满时不阻塞，强制写入（兜底） -->
    </appender>

    <!-- 异步依赖的同步文件Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${file_pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.log%i.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize> <!-- 复用全局配置 -->
            <maxHistory>${MAX_HISTORY}</maxHistory>     <!-- 复用全局配置 -->
            <totalSizeCap>1GB</totalSizeCap>           <!-- 总日志容量上限 -->
        </rollingPolicy>
    </appender>

    <!-- 补全：仅记录ERROR级别的同步文件Appender（兜底） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${file_pattern}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.log%i.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory> <!-- ERROR日志保留90天 -->
        </rollingPolicy>
    </appender>

    <!--root logger 配置-->
    <root level="INFO">
        <appender-ref ref="console"></appender-ref>
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_ERROR_FILE"/>
    </root>

    <!--    自定义logger对象
    additivity="false" 是否继承rootLogger-->
    <logger name="com.peanut" level="info" additivity="false">
        <appender-ref ref="console"></appender-ref>
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_ERROR_FILE"/>
    </logger>

</configuration>